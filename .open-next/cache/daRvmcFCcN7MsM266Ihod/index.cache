n\",\"href\":\"https://pe.linkedin.com/company/inversionesdyc-peru\"},{\"icon\":\"fa fa-brands fa-tiktok\",\"href\":\"https://www.tiktok.com/@inversiones.dyc_logistic\"}],\"sendLetter\":{\"title\":\"ENVÍANOS UN CORREO\",\"description\":\"Recibe todas nuestras novedades.\",\"placeholderEmail\":\"Tu email\",\"icon\":\"fa fa-solid fa-paper-plane\"},\"copyrightText\":\"© 2026 Inversiones DyC. Todos los derechos reservados.\",\"brandText\":\"Diseñado por corporaciones para corporaciones\",\"messageSuccess\":\"✅ ¡Listo! Ahora estás suscrito a nuestras novedades.\",\"messageError\":\"❌ Hubo un error al registrar tu email, inténtalo más tarde.\"}}],\"$Lf\",\"$L10\",\"$L11\"]}]}]\n13:T730,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"NUESTRO PROCESO\",\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Negociación con el Proveedor\",\"text\":\"Establecemos contacto directo con el fabricante para acordar los mejores precios, términos de pago y tiempos de entrega garantizados.\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Pago del Adelanto (30%)\",\"text\":\"Realizamos la transferencia inicial del 30% para confirmar la orden e iniciar oficialmente el pedido con el proveedor.\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Orden de Producción\",\"text\":\"El proveedor inicia la fabricación de la mercancía bajo los estándares y especificaciones requeridas.\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Pago del Saldo Restante (70%)\",\"text\":\"Tras verificar la finalización de la producción, se efectúa el pago final del 70% para liberar la carga en origen.\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Reserva de Transporte Marítimo\",\"text\":\"Gestionamos la reserva del espacio en el buque naviero correspondiente para coordinar el embarque.\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Tránsito Marítimo\",\"text\":\"La mercancía inicia su viaje en alta mar, con un tiempo estimado de traslado de 30 a 45 días hasta llegar a destino.\"},{\"@type\":\"HowToStep\",\"position\":7,\"name\":\"Llegada y Descarga en Puerto\",\"text\":\"La carga arriba al puerto de destino y se procede con las maniobras de descarga en el terminal marítimo.\"},{\"@type\":\"HowToStep\",\"position\":8,\"name\":\"Despacho Aduanero\",\"text\":\"Realizamos la revisión documental, tramitación de impuestos y gestión del levante para nacionalizar la mercancía sin contratiempos.\"},{\"@type\":\"HowToStep\",\"position\":9,\"name\":\"Retiro y Entrega Final\",\"text\":\"Retiramos la mercancía del puerto y la trasladamos de forma segura hasta tus almacenes o el destino final pactado.\"}]}4:[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L12\",null,{}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$13\"}}],[[\"$\",\"$L14\",\"2ImgWithMessage\",{\"data\":{\"isMainH1\":true,\"isAfterHeader\":true,\"coverScreen\":true,\"title\":\"INVERSIONES \",\"highLightTitle\":\"D&C\",\"subTitle\":\"Operador Logístico \",\"highLightSubTitle\":\"Internacional\",\"description\":\"Gestionamos todo el proceso de tu importación, desde el transporte internacional hasta la gestión aduanera y el seguimiento de tu carga.\",\"typeAnimationTitleSection\":\"left\",\"pixelsAnimationTitleSection\":80,\"durationAnimationTitleSection\":1000,\"delayAnimationTitleSection\":0,\"durationAnimationButtons\":1000,\"typeAnimationDescription\":\"right\",\"pixelsAnimationDescription\":80,\"durationAnimationDescription\":1000,\"delayAnimationDescription\":0,\"buttons\":[{\"text\":\"COTIZA TU SERVICIO\",\"type\":\"primary\",\"linkType\":\"\",\"href\":\"/cotizacion\"}],\"img\":\"/img/imagenesInicio/imagenPortada.webp\",\"altImg\":\"Inversiones DyC Hero\"}}],[\"$\",\"section\",\"4TeamShowCase\",{\"className\":\"teamShowCase \",\"id\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"teamShowCase-container\",\"children\":[[\"$\",\"$L15\",null,{\"animation\":\"left