nversiones D&amp;C | Importaciones y Logística Internacional\"/><meta property=\"og:description\" content=\"Te conectamos con proveedores en China, India, Brasil y EE.UU. y gestionamos toda tu importación de principio a fin.\"/><meta property=\"og:url\" content=\"https://inversionesdycperu.pe\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Inversiones D&amp;C | Operador Logístico Internacional\"/><meta name=\"twitter:description\" content=\"Operador Logístico Internacional con presencia en Europa, Asia y Latinoamérica. Gestionamos tu importación de principio a fin: agenciamiento de carga y aduana, seguro internacional y transporte local en Perú.\"/><meta name=\"twitter:image\" content=\"https://inversionesdycperu.pe/img/imagenesInicio/imagenOg.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2zz4u_4ssg4zy.ico\" sizes=\"53x53\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.ico\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"name\":\"Inversiones D&C\",\"alternateName\":\"Inversiones DyC Perú\",\"url\":\"https://inversionesdycperu.pe/\",\"logo\":\"https://inversionesdycperu.pe//img/imagenesInicio/imagenLogo.png\",\"image\":\"/img/imagenesInicio/imagenOg.jpg\",\"description\":\"Operador Logístico Internacional con presencia en Europa, Asia y Latinoamérica. Ofrecemos soluciones de logística y comercio internacional para importaciones seguras y eficientes.\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Calle Capitán Guitierrez Rondón, 196 - Miraflores, Lima, Perú 15074\",\"addressLocality\":\"Miraflores\",\"addressRegion\":\"Lima\",\"postalCode\":\"15074\",\"addressCountry\":\"PE\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":-12.1289221,\"longitude\":-77.0077074},\"contactPoint\":{\"@type\":\"ContactPoint\",\"telephone\":\"+51 961 831 404\",\"email\":\"inversionesdycperu@gmail.com\",\"contactType\":\"sales\",\"areaServed\":\"PE\",\"availableLanguage\":[\"Spanish\"]},\"areaServed\":[\"CHINA\",\"INDIA\",\"BRASIL\",\"EE. UU\"],\"sameAs\":[\"https://www.facebook.com/InversionesDyCPeru/\",\"https://www.instagram.com/inversionesdycsac/\",\"https://x.com/DycInversiones\",\"https://pe.linkedin.com/company/inversionesdyc-peru\",\"https://www.tiktok.com/@inversiones.dyc_logistic\"],\"openingHoursSpecification\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\"],\"opens\":\"09:00\",\"closes\":\"18:00\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Servicios Inversiones D&C\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Agenciamiento de Carga\",\"url\":\"https://inversionesdycperu.pe//servicios/agenciamiento-carga\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Agenciamiento de Aduana\",\"url\":\"https://inversionesdycperu.pe//servicios/agenciamiento-aduana\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Desaduanaje\",\"url\":\"https://inversionesdycperu.pe//servicios/desaduanaje\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Seguro Internacional\",\"url\":\"https://inversionesdycperu.pe//servicios/seguro-internacional\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Transporte Local\",\"url\":\"https://inversionesdycperu.pe//servicios/transporte-local\"}}]}}</script><link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css\"/><link href=\"https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&amp;family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&amp;display=swap\" rel=\"stylesheet\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><header class=\"header header-noTransparent\"><div class=\"header-logo\"><a class=\"header-logo-link\" href=\"/\"><img src=\"/img/imagenesInicio/imagenLogo.png\" alt=\"Logo de Inversiones D&amp;C\" class=\"header-logo-img\"/></a></div><button type=\"button\" class=\"header-mobile-toggle\" aria-expanded=\"false\" aria-label=\"Abrir menú\"><span></span><span></span><span></span></button><nav class=\"header-links\" aria-label=\"Navegación principal\"><a class=\"header-links-item header-links-item-selected\" href=\"/\"><h4 class=\"header-links-item-text \">Inicio</h4></a><a class=\"header-links-item \" href=\"/nosotros\"><h4 class=\"header-links-item-text \">Nosotros</h4></a><div class=\"header-links-item \"><h4 class=\"header-links-item-text \">Servicios</h4><i class=\"header-links-item-icon fa fa-solid fa-caret-down\"></i><div class=\"header-dropdown\"><a class=\"header-dropdown-item \" href=\"/servicios/agenciamiento-aduana\">Agenciamiento de Aduana</a><a class=\"header-dropdown-item \" href=\"/servicios/agenciamiento-carga\">Agenciamiento de Carga</a><a class=\"header-dropdown-item \" href=\"/servicios/desaduanaje\">Desaduanaje</a><a class=\"header-dropdown-item \" href=\"/servicios/seguro-internacional\">Seguro Internacional</a><a class=\"header-dropdown-item \" href=\"/servicios/transporte-local\">Transporte Local</a></div></div><a href=\"https://trackingwebsac.andessystems.com/e7vEMQ-5IwYYZyU=/login\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"header-links-item \"><h4 class=\"header-links-item-text \">Tracking Web</h4></a><a class=\"header-links-item \" href=\"/calendar\"><h4 class=\"header-links-item-text \">Reserva de Cita</h4></a><a class=\"header-links-item \" href=\"/cotizacion\"><h4 class=\"header-links-item-text \">Cotización</h4></a></nav><nav class=\"header-mobile-menu \" aria-label=\"Navegación móvil\"><div class=\"header-mobile-item\"><a class=\"header-mobile-item-toggle header-mobile-link-only header-links-item-selected-mobile\" href=\"/\"><span>Inicio</span></a></div><div class=\"header-mobile-item\"><a class=\"header-mobile-item-toggle header-mobile-link-only \" href=\"/nosotros\"><span>Nosotros</span></a></div><div class=\"header-mobile-item\"><button type=\"button\" class=\"header-mobile-item-toggle \"><span>Servicios</span><i class=\"header-links-item-icon fa fa-solid fa-caret-down\"></i></button><div class=\"header-mobile-sublinks \"><a class=\"header-mobile-sublink \" href=\"/servicios/agenciamiento-aduana\">Agenciamiento de Aduana</a><a class=\"header-mobile-sublink \" href=\"/servicios/agenciamiento-carga\">Agenciamiento de Carga</a><a class=\"header-mobile-sublink \" href=\"/servicios/desaduanaje\">Desaduanaje</a><a class=\"header-mobile-sublink \" href=\"/servicios/seguro-internacional\">Seguro Internacional</a><a class=\"header-mobile-sublink \" href=\"/servicios/transporte-local\">Transporte Local</a></div></div><div class=\"header-mobile-item\"><a class=\"header-mobile-item-toggle header-mobile-link-only \" href=\"https://trackingwebsac.andessystems.com/e7vEMQ-5IwYYZyU=/login\"><span>Tracking Web</span></a></div><div class=\"header-mobile-item\"><a class=\"header-mobile-item-toggle header-mobile-link-only \" href=\"/calendar\"><span>Reserva de Cita</span></a></div><div class=\"header-mobile-item\"><a class=\"header-mobile-item-toggle header-mobile-link-only \" href=\"/cotizacion\"><span>Cotización</span></a></div></nav></header><main><div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"NUESTRO PROCESO\",\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Negociación con el Proveedor\",\"text\":\"Establecemos contacto directo con el fabricante para acordar los mejores precios, términos de pago y tiempos de entrega garantizados.\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Pago del Adelanto (30%)\",\"text\":\"Realizamos la transferencia inicial del 30% para confirmar la orden e iniciar oficialmente el pedido con el proveedor.\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Orden de Producción\",\"text\":\"El proveedor inicia la fabricación de la mercancía bajo los estándares y especificaciones requeridas.\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Pago del Saldo Restante (70%)\",\"text\":\"Tras verificar la finalización de la producción, se efectúa el pago final del 70% para liberar la carga en origen.\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Reserva de Transporte Marítimo\",\"text\":\"Gestionamos la reserva del espacio en el buque naviero correspondiente para coordinar el embarque.\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Tránsito Marítimo\",\"text\":\"La mercancía inicia su viaje en alta mar, con un tiempo estimado de traslado de 30 a 45 días hasta llegar a destino.\"},{\"@type\":\"HowToStep\",\"position\":7,\"name\":\"Llegada y Descarga en Puerto\",\"text\":\"La carga arriba al puerto de destino y se procede con las maniobras de descarga en el terminal marítimo.\"},{\"@type\":\"HowToStep\",\"position\":8,\"name\":\"Despacho Aduanero\",\"text\":\"Realizamos la revisión documental, tramitación de impuestos y gestión del levante para nacionalizar la mercancía sin contratiempos.\"},{\"@type\":\"HowToStep\",\"position\":9,\"name\":\"Retiro y Entrega Final\",\"text\":\"Retiramos la mercancía del puerto y la trasladamos de forma segura hasta tus almacenes o el destino final pactado.\"}]}</script><section class=\"imgWithMessage imgWithMessageAllScreen\"><img alt=\"Inversiones DyC Hero\" fetchPriority=\"high\" width=\"1920\" height=\"800\" decoding=\"async\" data-nimg=\"1\" class=\"imgWithMessage-img\" style=\"color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimg%2FimagenesInicio%2FimagenPortada.webp&amp;w=3840&amp;q=75\"/><div class=\"imgWithMessage-text\"><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><h1 class=\"imgWithMessage-text-title\">INVERSIONES <span class=\"imgWithMessage-text-title-highligh\">D&amp;C</span></h1></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><p class=\"imgWithMessage-text-underTitle\"></p></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><p class=\"imgWithMessage-text-subtitle\">Operador Logístico <span class=\"imgWithMessage-text-subtitle-highligh\">Internacional</span></p></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><div class=\"imgWithMessage-divider\" aria-hidden=\"true\"></div></div><div class=\"scrollAnimation scrollAnimation-right \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><p class=\"imgWithMessage-text-description\">Gestionamos todo el proceso de tu importación, desde el transporte internacional hasta la gestión aduanera y el seguimiento de tu carga.</p></div><nav class=\"imgWithMessage-text-buttons\"><a class=\"imgWithMessage-text-buttons-button buttonPrimary\" href=\"/cotizacion\">COTIZA TU SERVICIO</a></nav></div></section><section class=\"teamShowCase \"><div class=\"teamShowCase-container\"><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><div class=\"teamShowCase-text\"><p class=\"teamShowCase-text-subTitle\">Somos un Operador Logístico Internacional</p><h2 class=\"teamShowCase-text-title\"><span class=\"teamShowCase-text-title-highligh\">INVERSIONES </span>D&amp;C</h2><div class=\"teamShowCase-text-divider\" aria-hidden=\"true\"></div><p class=\"teamShowCase-text-description\">Ofrecemos soluciones logísticas integrales a través de servicios agenciamiento de carga y aduana, seguro internacional, almacenaje, así como asesorías internacionales de compra y venta de productos. Nos adaptamos a las necesidades de cada cliente para brindar un servicio personalizado.</p></div></div><div class=\"teamShowCase-people\"><div class=\"scrollAnimation scrollAnimation-right \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><div class=\"teamShowCase-people-line\" aria-hidden=\"true\"></div></div><ul class=\"teamShowCase-people-imgs\" role=\"list\"><div class=\"scrollAnimation scrollAnimation-zoom \" style=\"--animation-displacement:0px;--scroll-delay:200ms;--scroll-duration:1000ms\"><li class=\"teamShowCase-people-imgs-person\" role=\"listitem\"><img class=\"teamShowCase-people-imgs-person-img\" alt=\"Daisy Clerque\" src=\"/img/imagenesInicio/imagenTeam2.jpg\"/><h3 class=\"teamShowCase-people-imgs-person-name\">Daisy Clerque</h3><p class=\"teamShowCase-people-imgs-person-position\">CEO Fundadora</p><p class=\"teamShowCase-people-imgs-person-description\">Enfocada en fortalecer nuestro compromiso y generar valor para nuestros clientes.</p></li></div><div class=\"scrollAnimation scrollAnimation-zoom \" style=\"--animation-displacement:0px;--scroll-delay:400ms;--scroll-duration:1000ms\"><li class=\"teamShowCase-people-imgs-person\" role=\"listitem\"><img class=\"teamShowCase-people-imgs-person-img\" alt=\"Cristina Gonzales\" src=\"/img/imagenesInicio/imagenTeam1.jpg\"/><h3 class=\"teamShowCase-people-imgs-person-name\">Cristina Gonzales</h3><p class=\"teamShowCase-people-imgs-person-position\">Gerente General</p><p class=\"teamShowCase-people-imgs-person-description\">Trabajando siempre para ofrecer confianza, calidad y el mejor servicio a nuestros clientes.</p></li></div></ul><div class=\"scrollAnimation scrollAnimation-up \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><div class=\"teamShowCase-people-button\"><a class=\"buttonPrimary\" href=\"/nosotros\">Ver Más</a></div></div></div></div></section><section class=\"ourMetrics \" style=\"background-image:url(/img/imagenesInicio/fondoMetricas.jpg)\"><div class=\"ourMetrics-metric\"><div class=\"ourMetrics-metric-content\"><div class=\"ourMetrics-metric-header\"><i class=\"ourMetrics-metric-header-icon fa fa-solid fa-briefcase\" aria-hidden=\"true\"></i><p class=\"ourMetrics-metric-header-title\"><span aria-hidden=\"true\">+<!-- -->0</span><span class=\"sr-only\">+<!-- -->300</span></p></div><p class=\"ourMetrics-metric-text-description\">Empresarios satisfechos</p></div></div><div class=\"ourMetrics-metric-divider \"></div><div class=\"ourMetrics-metric\"><div class=\"ourMetrics-metric-content\"><div class=\"ourMetrics-metric-header\"><i class=\"ourMetrics-metric-header-icon fa fa-solid fa-globe\" aria-hidden=\"true\"></i><p class=\"ourMetrics-metric-header-title\"><span aria-hidden=\"true\">+<!-- -->0</span><span class=\"sr-only\">+<!-- -->500</span></p></div><p class=\"ourMetrics-metric-text-description\">Importaciones gestionadas</p></div></div><div class=\"ourMetrics-metric-divider ourMetrics-metric-dividerPar \"></div><div class=\"ourMetrics-metric\"><div class=\"ourMetrics-metric-content\"><div class=\"ourMetrics-metric-header\"><i class=\"ourMetrics-metric-header-icon fa fa-solid fa-users\" aria-hidden=\"true\"></i><p class=\"ourMetrics-metric-header-title\"><span aria-hidden=\"true\">+<!-- -->0</span><span class=\"sr-only\">+<!-- -->200</span></p></div><p class=\"ourMetrics-metric-text-description\">Empresas satisfechas</p></div></div><div class=\"ourMetrics-metric-divider \"></div><div class=\"ourMetrics-metric\"><div class=\"ourMetrics-metric-content\"><div class=\"ourMetrics-metric-header\"><i class=\"ourMetrics-metric-header-icon fa fa-solid fa-user-shield\" aria-hidden=\"true\"></i><p class=\"ourMetrics-metric-header-title\"><span aria-hidden=\"true\">0<!-- -->%</span><span class=\"sr-only\">100<!-- -->%</span></p></div><p class=\"ourMetrics-metric-text-description\">Compromiso y empeño</p></div></div></section><section class=\"carrouselTravels \" id=\"#ourTravelsInicio\"><div class=\"scrollAnimation scrollAnimation-right \" style=\"--animation-displacement:80px;--scroll-delay:ms;--scroll-duration:1000ms\"><div class=\"carrouselTravels-text\"><p class=\"carrouselTravels-text-subTitle\">Garantizamos la entrega de tu mercadería</p><h2 class=\"carrouselTravels-text-title\">Conoce nuestros Servicios</h2><div class=\"carrouselTravels-text-divider\" aria-hidden=\"true\"></div></div></div><div class=\"carrouselTravels-companies\"><div class=\"embla \" role=\"region\" aria-roledescription=\"carousel\" aria-label=\"Carrousel de Destinos\"><div class=\"embla-buttons \"><button class=\"embla__prev\" aria-label=\"Anterior\"><i class=\"embla__prev-icon fa fa-solid fa-chevron-left\" aria-hidden=\"true\"></i></button><button class=\"embla__next\" aria-label=\"Siguiente\"><i class=\"embla__prev-icon fa fa-solid fa-chevron-right\" aria-hidden=\"true\"></i></button></div><div class=\"embla__viewport\"><ul class=\"embla__container\" role=\"list\"><li class=\"embla__slide embla__slidecarrouselTravels\" role=\"listitem\"><a class=\"carrouselTravels-companies-item \" href=\"/servicios/agenciamiento-carga\"><img src=\"/img/imagenesInicio/agencCarga.webp\" alt=\"Agenciamiento de Carga\" class=\"carrouselTravels-companies-item-content-image\"/><div class=\"carrouselTravels-companies-item-content\"><div class=\"carrouselTravels-companies-item-text\"><h3 class=\"carrouselTravels-companies-item-text-title\"><span class=\"carrouselTravels-companies-item-text-title1\">Agenciamiento</span><br/><span class=\"carrouselTravels-companies-item-text-title2\">de Carga</span></h3><div class=\"carrouselTravels-companies-item-text-divider\"></div><h3 class=\"carrouselTravels-companies-item-text-duration\"></h3></div><div class=\"carrouselTravels-companies-item-information-container\"><div class=\"carrouselTravels-companies-item-information\"><div class=\"carrouselTravels-companies-item-information-price\"><p class=\"carrouselTravels-companies-item-information-price-description\"></p><p class=\"carrouselTravels-companies-item-information-price-value\"></p></div><span class=\"carrouselTravels-companies-item-information-button\">Entérate de más</span></div><div class=\"carrouselTravels-companies-item-lowPart\"><p>Gestión de tu carga</p></div></div></div></a></li><li class=\"embla__slide embla__slidecarrouselTravels\" role=\"listitem\"><a class=\"carrouselTravels-companies-item \" href=\"/servicios/seguro-internacional\"><img src=\"/img/imagenesInicio/imagenViaje3.jpg\" alt=\"Seguro Internacional\" class=\"carrouselTravels-companies-item-content-image\"/><div class=\"carrouselTravels-companies-item-content\"><div class=\"carrouselTravels-companies-item-text\"><h3 class=\"carrouselTravels-companies-item-text-title\"><span class=\"carrouselTravels-companies-item-text-title1\">Seguro</span><br/><span class=\"carrouselTravels-companies-item-text-title2\">Internacional</span></h3><div class=\"carrouselTravels-companies-item-text-divider\"></div><h3 class=\"carrouselTravels-companies-item-text-duration\"></h3></div><div class=\"carrouselTravels-companies-item-information-container\"><div class=\"carrouselTravels-companies-item-information\"><div class=\"carrouselTravels-companies-item-information-price\"><p class=\"carrouselTravels-companies-item-information-price-description\"></p><p class=\"carrouselTravels-companies-item-information-price-value\"></p></div><span class=\"carrouselTravels-companies-item-information-button\">Entérate de más</span></div><div class=\"carrouselTravels-companies-item-lowPart\"><p>Protege tu mercancía</p></div></div></div></a></li><li class=\"embla__slide embla__slidecarrouselTravels\" role=\"listitem\"><a class=\"carrouselTravels-companies-item \" href=\"/servicios/desaduanaje\"><img src=\"/img/imagenesInicio/desaduanaje.webp\" alt=\"Desaduanaje\" class=\"carrouselTravels-companies-item-content-image\"/><div class=\"carrouselTravels-companies-item-content\"><div class=\"carrouselTravels-companies-item-text\"><h3 class=\"carrouselTravels-companies-item-text-title\"><span class=\"carrouselTravels-companies-item-text-title1\">Desaduanaje</span><br/><span class=\"carrouselTravels-companies-item-text-title2\"></span></h3><div class=\"carrouselTravels-companies-item-text-divider\"></div><h3 class=\"carrouselTravels-companies-item-text-duration\"></h3></div><div class=\"carrouselTravels-companies-item-information-container\"><div class=\"carrouselTravels-companies-item-information\"><div class=\"carrouselTravels-companies-item-information-price\"><p class=\"carrouselTravels-companies-item-information-price-description\"></p><p class=\"carrouselTravels-companies-item-information-price-value\"></p></div><span class=\"carrouselTravels-companies-item-information-button\">Entérate de más</span></div><div class=\"carrouselTravels-companies-item-lowPart\"><p>Agilizamos tu mercancía</p></div></div></div></a></li><li class=\"embla__slide embla__slidecarrouselTravels\" role=\"listitem\"><a class=\"carrouselTravels-companies-item \" href=\"/servicios/agenciamiento-aduana\"><img src=\"/img/imagenesInicio/agencAduana.webp\" alt=\"Agenciamiento de Aduana\" class=\"carrouselTravels-companies-item-content-image\"/><div class=\"carrouselTravels-companies-item-content\"><div class=\"carrouselTravels-companies-item-text\"><h3 class=\"carrouselTravels-companies-item-text-title\"><span class=\"carrouselTravels-companies-item-text-title1\">Agenciamiento</span><br/><span class=\"carrouselTravels-companies-item-text-title2\">de Aduana</span></h3><div class=\"carrouselTravels-companies-item-text-divider\"></div><h3 class=\"carrouselTravels-companies-item-text-duration\"></h3></div><div class=\"carrouselTravels-companies-item-information-container\"><div class=\"carrouselTravels-companies-item-information\"><div class=\"carrouselTravels-companies-item-information-price\"><p class=\"carrouselTravels-companies-item-information-price-description\"></p><p class=\"carrouselTravels-companies-item-information-price-value\"></p></div><span class=\"carrouselTravels-companies-item-information-button\">Entérate de más</span></div><div class=\"carrouselTravels-companies-item-lowPart\"><p>Gestión aduanera</p></div></div></div></a></li><li class=\"embla__slide embla__slidecarrouselTravels\" role=\"listitem\"><a class=\"carrouselTravels-companies-item \" href=\"/servicios/transporte-local\"><img src=\"/img/imagenesInicio/transporteLocal.webp\" alt=\"Transporte Local\" class=\"carrouselTravels-companies-item-content-image\"/><div class=\"carrouselTravels-companies-item-content\"><div class=\"carrouselTravels-companies-item-text\"><h3 class=\"carrouselTravels-companies-item-text-title\"><span class=\"carrouselTravels-companies-item-text-title1\">Transporte</span><br/><span class=\"carrouselTravels-companies-item-text-title2\">Local</span></h3><div class=\"carrouselTravels-companies-item-text-divider\"></div><h3 class=\"carrouselTravels-companies-item-text-duration\"></h3></div><div class=\"carrouselTravels-companies-item-information-container\"><div class=\"carrouselTravels-companies-item-information\"><div class=\"carrouselTravels-companies-item-information-price\"><p class=\"carrouselTravels-companies-item-information-price-description\"></p><p class=\"carrouselTravels-companies-item-information-price-value\"></p></div><span class=\"carrouselTravels-companies-item-information-button\">Entérate de más</span></div><div class=\"carrouselTravels-companies-item-lowPart\"><p>Entrega en todo el Perú</p></div></div></div></a></li></ul></div></div></div></section><section class=\"circleItems \"><div class=\"scrollAnimation scrollAnimation-down \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><div class=\"circleItems-header\"><h2 class=\"circleItems-header-title\">NUESTRO PROCESO</h2><div class=\"circleItems-header-divider\" aria-hidden=\"true\"></div></div></div><div class=\"circleItems-component\"><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:0px;--scroll-delay:0ms;--scroll-duration:1000ms\"><ul class=\"circleItems-component-steps\"><svg class=\"circleItems-track\" viewBox=\"0 0 600 600\"><circle class=\"circleItems-track-bg\" cx=\"300\" cy=\"300\" r=\"270\"></circle><circle class=\"circleItems-track-progress\" cx=\"300\" cy=\"300\" r=\"270\" stroke-dasharray=\"1696.4600329384882\" stroke-dashoffset=\"1696.4600329384882\"></circle></svg><li class=\"circleItems-component-steps-button circleItems-component-steps-button-active\" style=\"--angle:0deg;background:linear-gradient(90deg, rgb(19, 28, 71), rgb(29, 51, 93))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-phone\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Contacto</p></li><li class=\"circleItems-component-steps-button \" style=\"--angle:40deg;background:linear-gradient(90deg, rgb(19, 28, 71), rgb(38, 73, 115))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-money-check-dollar\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Pago Inicial</p></li><li class=\"circleItems-component-steps-button \" style=\"--angle:80deg;background:linear-gradient(90deg, rgb(29, 51, 93), rgb(48, 96, 137))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-industry\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Fabricación</p></li><li class=\"circleItems-component-steps-button \" style=\"--angle:120deg;background:linear-gradient(90deg, rgb(38, 73, 115), rgb(57, 118, 159))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-money-bill-wave\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Pago Final</p></li><li class=\"circleItems-component-steps-button \" style=\"--angle:160deg;background:linear-gradient(90deg, rgb(48, 96, 137), rgb(67, 141, 181))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-ship\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Reserva</p></li><li class=\"circleItems-component-steps-button \" style=\"--angle:200deg;background:linear-gradient(90deg, rgb(57, 118, 159), rgb(76, 163, 203))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-truck-fast\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Tránsito</p></li><li class=\"circleItems-component-steps-button \" style=\"--angle:240deg;background:linear-gradient(90deg, rgb(67, 141, 181), rgb(86, 186, 225))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-box-open\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Descarga</p></li><li class=\"circleItems-component-steps-button \" style=\"--angle:280deg;background:linear-gradient(90deg, rgb(76, 163, 203), rgb(95, 208, 247))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-file-invoice\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Aduanas</p></li><li class=\"circleItems-component-steps-button \" style=\"--angle:320deg;background:linear-gradient(90deg, rgb(86, 186, 225), rgb(95, 208, 247))\"><i class=\"circleItems-component-steps-button-icon fa fa-solid fa-handshake\" aria-hidden=\"true\"></i><p class=\"circleItems-component-steps-button-text\">Entrega</p></li></ul></div><div class=\"circleItems-component-steps-detail\"><div class=\"circleItems-component-steps-detail-img-container\"><img class=\"circleItems-component-steps-detail-img\" src=\"/img/imagenesInicio/imagenPaso1.webp\" alt=\"Negociación con el Proveedor\"/></div><h3 class=\"circleItems-component-steps-detail-title\">Negociación con el Proveedor</h3><p class=\"circleItems-component-steps-detail-description\">Establecemos contacto directo con el fabricante para acordar los mejores precios, términos de pago y tiempos de entrega garantizados.</p></div><ul class=\"sr-only\"><li><h3>Negociación con el Proveedor</h3><p>Establecemos contacto directo con el fabricante para acordar los mejores precios, términos de pago y tiempos de entrega garantizados.</p><img src=\"/img/imagenesInicio/imagenPaso1.webp\" alt=\"Negociación con el Proveedor\"/></li><li><h3>Pago del Adelanto (30%)</h3><p>Realizamos la transferencia inicial del 30% para confirmar la orden e iniciar oficialmente el pedido con el proveedor.</p><img src=\"/img/imagenesInicio/imgProcesos2.jpg\" alt=\"Pago del Adelanto (30%)\"/></li><li><h3>Orden de Producción</h3><p>El proveedor inicia la fabricación de la mercancía bajo los estándares y especificaciones requeridas.</p><img src=\"/img/imagenesInicio/imgProcesos3.webp\" alt=\"Orden de Producción\"/></li><li><h3>Pago del Saldo Restante (70%)</h3><p>Tras verificar la finalización de la producción, se efectúa el pago final del 70% para liberar la carga en origen.</p><img src=\"/img/imagenesInicio/imgProcesos4.webp\" alt=\"Pago del Saldo Restante (70%)\"/></li><li><h3>Reserva de Transporte Marítimo</h3><p>Gestionamos la reserva del espacio en el buque naviero correspondiente para coordinar el embarque.</p><img src=\"/img/imagenesInicio/imgProcesos5.webp\" alt=\"Reserva de Transporte Marítimo\"/></li><li><h3>Tránsito Marítimo</h3><p>La mercancía inicia su viaje en alta mar, con un tiempo estimado de traslado de 30 a 45 días hasta llegar a destino.</p><img src=\"/img/imagenesInicio/imgProcesos6.webp\" alt=\"Tránsito Marítimo\"/></li><li><h3>Llegada y Descarga en Puerto</h3><p>La carga arriba al puerto de destino y se procede con las maniobras de descarga en el terminal marítimo.</p><img src=\"/img/imagenesInicio/imgProcesos7.webp\" alt=\"Llegada y Descarga en Puerto\"/></li><li><h3>Despacho Aduanero</h3><p>Realizamos la revisión documental, tramitación de impuestos y gestión del levante para nacionalizar la mercancía sin contratiempos.</p><img src=\"/img/imagenesInicio/imgProcesos8.webp\" alt=\"Despacho Aduanero\"/></li><li><h3>Retiro y Entrega Final</h3><p>Retiramos la mercancía del puerto y la trasladamos de forma segura hasta tus almacenes o el destino final pactado.</p><img src=\"/img/imagenesInicio/imgProcesos9.jpg\" alt=\"Retiro y Entrega Final\"/></li></ul></div><ul class=\"circleItems-mobile-list\"><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:200ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(19, 28, 71)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-phone\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Negociación con el Proveedor</p></li></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:400ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(29, 51, 93)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-money-check-dollar\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Pago del Adelanto (30%)</p></li></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:600ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(38, 73, 115)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-industry\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Orden de Producción</p></li></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:800ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(48, 96, 137)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-money-bill-wave\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Pago del Saldo Restante (70%)</p></li></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:1000ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(57, 118, 159)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-ship\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Reserva de Transporte Marítimo</p></li></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:1200ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(67, 141, 181)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-truck-fast\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Tránsito Marítimo</p></li></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:1400ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(76, 163, 203)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-box-open\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Llegada y Descarga en Puerto</p></li></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:1600ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(86, 186, 225)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-file-invoice\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Despacho Aduanero</p></li></div><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:1800ms;--scroll-duration:1000ms\"><li class=\"circleItems-mobile-item\" style=\"background:rgb(95, 208, 247)\"><i class=\"circleItems-mobile-item-icon fa fa-solid fa-handshake\" aria-hidden=\"true\"></i><p class=\"circleItems-mobile-item-text\">Retiro y Entrega Final</p></li></div></ul></section><section class=\"connectCountries \"><div class=\"scrollAnimation scrollAnimation-down \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><div class=\"connectCountries-header\"><h2 class=\"connectCountries-header-title\">¿A QUÉ PAÍSES TE CONECTAMOS?</h2><div class=\"connectCountries-divider\" aria-hidden=\"true\"></div></div></div><ul class=\"connectCountries-countries\"><div class=\"scrollAnimation scrollAnimation-zoom \" style=\"--animation-displacement:60px;--scroll-delay:0ms;--scroll-duration:1000ms\"><li class=\"connectCountries-countries-item\"><div class=\"connectCountries-countries-item-images\"><img src=\"/img/imagenesInicio/fondoChina.jpg\" alt=\"Ciudad de CHINA\" loading=\"lazy\" class=\"connectCountries-countries-item-images-background\"/><img src=\"/img/imagenesInicio/banderaChina.jpg\" alt=\"Bandera de CHINA\" loading=\"lazy\" class=\"connectCountries-countries-item-images-flag\"/></div><div class=\"connectCountries-countries-item-text\"><h3 class=\"connectCountries-countries-item-text-title\" style=\"color:#DE2910\">CHINA</h3><p class=\"connectCountries-countries-item-text-description\">Encuentra proveedores y fabricantes confiables en China y déjanos gestionar el proceso para llevar tus productos hasta el Perú.</p></div></li></div><div class=\"scrollAnimation scrollAnimation-zoom \" style=\"--animation-displacement:60px;--scroll-delay:0ms;--scroll-duration:1000ms\"><li class=\"connectCountries-countries-item\"><div class=\"connectCountries-countries-item-images\"><img src=\"/img/imagenesInicio/fondoIndia.jpg\" alt=\"Ciudad de INDIA\" loading=\"lazy\" class=\"connectCountries-countries-item-images-background\"/><img src=\"/img/imagenesInicio/banderaIndia.jpg\" alt=\"Bandera de INDIA\" loading=\"lazy\" class=\"connectCountries-countries-item-images-flag\"/></div><div class=\"connectCountries-countries-item-text\"><h3 class=\"connectCountries-countries-item-text-title\" style=\"color:#FF9933\">INDIA</h3><p class=\"connectCountries-countries-item-text-description\">Descubre nuevas oportunidades de negocio en India. Te ayudamos a conectar con proveedores y gestionar la importación de tus productos.</p></div></li></div><div class=\"scrollAnimation scrollAnimation-zoom \" style=\"--animation-displacement:60px;--scroll-delay:0ms;--scroll-duration:1000ms\"><li class=\"connectCountries-countries-item\"><div class=\"connectCountries-countries-item-images\"><img src=\"/img/imagenesInicio/fondoBrasil.jpg\" alt=\"Ciudad de BRASIL\" loading=\"lazy\" class=\"connectCountries-countries-item-images-background\"/><img src=\"/img/imagenesInicio/banderaBrasil.jpg\" alt=\"Bandera de BRASIL\" loading=\"lazy\" class=\"connectCountries-countries-item-images-flag\"/></div><div class=\"connectCountries-countries-item-text\"><h3 class=\"connectCountries-countries-item-text-title\" style=\"color:#009C3B\">BRASIL</h3><p class=\"connectCountries-countries-item-text-description\">Importa desde Brasil de manera sencilla y segura. Te acompañamos en la búsqueda de proveedores y en cada etapa de tu operación logística.</p></div></li></div><div class=\"scrollAnimation scrollAnimation-zoom \" style=\"--animation-displacement:60px;--scroll-delay:0ms;--scroll-duration:1000ms\"><li class=\"connectCountries-countries-item\"><div class=\"connectCountries-countries-item-images\"><img src=\"/img/imagenesInicio/fondoEeuu.jpg\" alt=\"Ciudad de EE. UU\" loading=\"lazy\" class=\"connectCountries-countries-item-images-background\"/><img src=\"/img/imagenesInicio/banderaEeuu.jpg\" alt=\"Bandera de EE. UU\" loading=\"lazy\" class=\"connectCountries-countries-item-images-flag\"/></div><div class=\"connectCountries-countries-item-text\"><h3 class=\"connectCountries-countries-item-text-title\">EE. UU</h3><p class=\"connectCountries-countries-item-text-description\">Conecta con proveedores y oportunidades comerciales en Estados Unidos. Nosotros te acompañamos para hacer realidad tu proceso de importación.</p></div></li></div></ul></section><section class=\"carrouselTravels \"><div class=\"scrollAnimation scrollAnimation-left \" style=\"--animation-displacement:80px;--scroll-delay:0ms;--scroll-duration:1000ms\"><div class=\"carrouselTravels-text\"><p class=\"carrouselTravels-text-subTitle\">Nuestros socios son tus socios</p><h2 class=\"carrouselTravels-text-title\">Navieras Asociadas</h2></div></div><div class=\"carrouselTravels-companies\"><div class=\"embla emblaButtonSides\" role=\"region\" aria-roledescription=\"carousel\" aria-label=\"Carrusel\"><div class=\"embla-buttons embla-buttons-noShowOnDesktop\"><button class=\"embla__prev\" aria-label=\"Anterior\"><i class=\"embla__prev-icon fa fa-solid fa-chevron-left\" aria-hidden=\"true\"></i></button><button class=\"embla__next\" aria-label=\"Siguiente\"><i class=\"embla__prev-icon fa fa-solid fa-chevron-right\" aria-hidden=\"true\"></i></button></div><button class=\"embla__prev embla__prevAtSide\" aria-label=\"Anterior\"><i class=\"embla__prev-icon fa fa-solid fa-chevron-left\" aria-hidden=\"true\"></i></button><div class=\"embla__viewport\"><ul class=\"embla__container\" role=\"list\"><li class=\"embla__slide embla__slidecarrouselImgs\" role=\"listitem\"><div class=\"carrouselImgs-companies-item \"><img alt=\"Logo Naviera Mediterranean Shipping Company\" src=\"/img/imagenesInicio/imagenCarrouselCompanies1.jpg\" class=\"carrouselImgs-companies-item-img\"/></div></li><li class=\"embla__slide embla__slidecarrouselImgs\" role=\"listitem\"><div class=\"carrouselImgs-companies