ersionesdycperu.pe/servicios/desaduanaje#service\\\",\\\"name\\\":\\\"Desaduanaje\\\",\\\"serviceType\\\":\\\"Desaduanaje\\\",\\\"description\\\":\\\"Agilizamos el levante de tu mercancía en aduanas, gestionando la documentación y trámites necesarios para nacionalizar tu carga sin retrasos ni sobrecostos.\\\",\\\"url\\\":\\\"https://inversionesdycperu.pe/servicios/desaduanaje\\\",\\\"areaServed\\\":{\\\"@type\\\":\\\"Country\\\",\\\"name\\\":\\\"Perú\\\"}}\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Inicio\\\",\\\"item\\\":\\\"https://inversionesdycperu.pe/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Desaduanaje\\\",\\\"item\\\":\\\"https://inversionesdycperu.pe/servicios/desaduanaje\\\"}]}\"}}],[[\"$\",\"$L15\",\"ImgWithMessage2\",{\"data\":{\"isAfterHeader\":true,\"coverScreen\":true,\"isMainH1\":true,\"title\":\"DESADUANAJE\",\"highLightTitle\":\"\",\"subTitle\":\"\",\"highLightSubTitle\":\"\",\"description\":\"Agilizamos el proceso de nacionalización de tu mercancía, gestionando la documentación y coordinación necesaria para liberar tu carga en el menor tiempo posible.\",\"typeAnimationTitleSection\":\"left\",\"pixelsAnimationTitleSection\":80,\"durationAnimationTitleSection\":1000,\"delayAnimationTitleSection\":0,\"typeAnimationDescription\":\"left\",\"pixelsAnimationDescription\":80,\"durationAnimationDescription\":1000,\"delayAnimationDescription\":0,\"buttons\":[],\"img\":\"/img/imagenesServicios/desaduanaje/portadaDesaduanaje.webp\",\"altImg\":\"Desaduanaje Inversiones D&C\"}}],[\"$\",\"$L16\",\"ImgWithDropdowns3\",{\"data\":{\"title\":\"DESADUANAJE\",\"description\":\"Gestionamos de manera integral el proceso de desaduanaje de sus mercancías, coordinando las diferentes etapas necesarias para logra